%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_victron.
%%
%% Victron GX telemetry (dbus-flashmq MQTT on the LAN), recorded in its own
%% reckon-db store and published on the mesh.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, health. It opens no
    %% store from 0.35 on (mcl-om#10), so this service declares and opens its
    %% own. Bounded below 0.36 so no unreviewed minor floats in; 0.34 and 0.35
    %% both work, since mcl_victron_app opens the store itself either way.
    {mcl_om, ">= 0.34.0 and < 0.36.0"},
    %% This service's own event store (mcl_victron_store). Floors: evoq 1.26.1
    %% measures telemetry durations on the monotonic clock (1.24 already marks
    %% a restart's replayed events, which the emitter skips: history is not
    %% live telemetry); reckon_evoq 2.7.2 reads snapshots back whole.
    {reckon_db,   "~> 5.4"},
    {evoq,        ">= 1.26.1 and < 2.0.0"},
    {reckon_evoq, ">= 2.7.2 and < 3.0.0"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

{relx, [
    {release, {mcl_victron, "0.1.0"}, [mcl_victron, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {test, [
        %% meck stands in for the mesh in the emitter tests.
        {deps, [{meck, "~> 1.2"}]},
        {eunit_opts, [{sys_config, "./config/test.sys.config"}]}
    ]},
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.

{dialyzer, [
    {warnings, [no_unknown]},
    {plt_extra_apps, [mcl_om, macula, evoq, reckon_evoq, reckon_db]}
]}.
