%% test.sys.config: the 12.x test environment.
[
    {kernel, [{logger_level, warning}]},
    %% ⚠ NO `puzzle_difficulty' HERE. macula 12 (D30) makes it one constant
    %% for the fleet and REFUSES a `{macula, puzzle_difficulty, _}' setting.
    {macula, [
        %% ⚠ THE SUITE'S OWN IDENTITY, NOT THE MACHINE'S. Unset, macula 12
        %% reads (and on a fresh machine writes) the identity of whatever is
        %% running the tests.
        {node_identity_path, "_build/test/node_identity.key"},
        {crypto_profile, pq_hybrid}
    ]}
].
